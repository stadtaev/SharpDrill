<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpDrill.Graph/SharpDrill.Graph.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Fact model and queries behind SharpDrill: entry points, exception report (what may escape, catches, misses), call graph and call diagrams, MSBuild project map and layer rules, over an immutable snapshot of a C# program. No Roslyn dependency.</Description>
    <PackageTags>static-analysis;call-graph;exceptions;aspnetcore;architecture;roslyn</PackageTags>
  </PropertyGroup>

</Project>
