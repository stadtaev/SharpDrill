<Project>

  <!-- SharpDrill: exception findings as build warnings after each build of the referencing project.
       SD0001 may escape a controller action; SD0002 may escape to a global exception handler; SD0003 passes through a try
       whose catches do not match; SD0004 third-party call with no catch on the way (only in strict mode, see below); SD0005 leaves an async void
       method, where no caller can catch it;
       SD0000 the analysis itself failed. Silence a rule with NoWarn, fail on one with WarningsAsErrors. -->
  <PropertyGroup>
    <!-- false skips the analysis, e.g. <SharpDrillEnabled Condition="'$(CI)' != 'true'">false</SharpDrillEnabled> for CI only. -->
    <SharpDrillEnabled Condition="'$(SharpDrillEnabled)' == ''">true</SharpDrillEnabled>
    <!-- What to analyse: this project and the projects it references, or a .sln/.slnx. -->
    <SharpDrillInput Condition="'$(SharpDrillInput)' == ''">$(MSBuildProjectFullPath)</SharpDrillInput>
    <!-- Extra options for sharpdrill exceptions: strict (adds SD0004), declared-only, budget N; see sharpdrill help. -->
    <SharpDrillArguments Condition="'$(SharpDrillArguments)' == ''"></SharpDrillArguments>
  </PropertyGroup>

  <PropertyGroup>
    <_SharpDrillHost>$(DOTNET_HOST_PATH)</_SharpDrillHost>
    <_SharpDrillHost Condition="'$(_SharpDrillHost)' == ''">dotnet</_SharpDrillHost>
    <!-- A multi-targeting project is analysed once, for its first framework. -->
    <_SharpDrillFramework>$(TargetFramework)</_SharpDrillFramework>
    <_SharpDrillFramework Condition="'$(TargetFrameworks)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(TargetFrameworks), '[^;\s]+'))</_SharpDrillFramework>
    <_SharpDrillFrameworkOption Condition="'$(TargetFrameworks)' != ''">--framework $(_SharpDrillFramework)</_SharpDrillFrameworkOption>
  </PropertyGroup>

  <Target Name="SharpDrillExceptions" AfterTargets="Build"
          Condition="'$(SharpDrillEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' == '$(_SharpDrillFramework)'">
    <!-- Findings are MSBuild's canonical "file(line,col): warning CODE: text" lines, which Exec logs as warnings;
         the rest of the CLI's output is detail for normal verbosity. Exit 1 only means some calls could not be followed. -->
    <Exec Command="&quot;$(_SharpDrillHost)&quot; &quot;$(MSBuildThisFileDirectory)../tools/net10.0/SharpDrill.Cli.dll&quot; exceptions &quot;$(SharpDrillInput)&quot; --format msbuild --configuration &quot;$(Configuration)&quot; $(_SharpDrillFrameworkOption) $(SharpDrillArguments)"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="normal">
      <Output TaskParameter="ExitCode" PropertyName="_SharpDrillExitCode" />
    </Exec>
    <Warning Condition="'$(_SharpDrillExitCode)' == '2'" Code="SD0000" File="$(SharpDrillInput)"
             Text="SharpDrill could not analyse $(SharpDrillInput); build with -v:n to see why. Set SharpDrillEnabled=false to skip it." />
  </Target>

</Project>
